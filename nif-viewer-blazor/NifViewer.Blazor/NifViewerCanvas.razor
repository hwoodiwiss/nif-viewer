@using Microsoft.AspNetCore.Components
@inject NifViewerInterop Interop
@implements IAsyncDisposable

<div id="@(Id + "-host")" style="@Style"></div>

@code {
    private uint? _navigationGeneration;
    private bool _disposed;
    /// <summary>Canvas element id; auto-generated if not set.</summary>
    [Parameter]
    public string Id { get; set; } = $"nif-canvas-{Guid.NewGuid():N}";

    /// <summary>Inline style for the canvas.</summary>
    [Parameter]
    public string Style { get; set; } = "width: 100%; aspect-ratio: 16/9;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Interop.InitializeAsync();
            _navigationGeneration = await Interop.AttachNavigationAsync(Id);
            if (_disposed)
            {
                await Interop.DetachNavigationAsync(_navigationGeneration.Value);
            }
        }
    }

    /// <summary>Load a NIF into this viewer.</summary>
    public Task<NifLoadResult> LoadNifAsync(string name, byte[] nif, INifDependencyResolver? resolver = null) =>
        Interop.LoadNifAsync(name, nif, resolver);

    public Task SetCameraSpeedAsync(float speed) => Interop.SetCameraSpeedAsync(speed);

    public Task SetLightAsync(NifLightSettings settings) => Interop.SetLightAsync(settings);

    public Task SetNavigationSettingsAsync(NifNavigationSettings settings) => Interop.SetNavigationSettingsAsync(settings);
    public Task<NifNavigationStatus> GetNavigationStatusAsync() => Interop.GetNavigationStatusAsync();
    public Task NavigationCommandAsync(string action) => Interop.NavigationCommandAsync(action);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_navigationGeneration is { } generation)
        {
            try
            {
                await Interop.DetachNavigationAsync(generation);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                // The browser context has already gone away.
            }
        }
    }
}
